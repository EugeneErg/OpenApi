{
  "name": "eugene-erg/open-api",
  "type": "library",
  "description": "Object-oriented builder for OpenAPI 3.0 specifications, with automatic $ref deduplication.",
  "keywords": [
    "openapi",
    "swagger",
    "openapi3",
    "api",
    "specification",
    "builder",
    "documentation"
  ],
  "homepage": "https://github.com/EugeneErg/OpenApi",
  "license": "MIT",
  "authors": [
    {
      "name": "Eugene Erg",
      "homepage": "https://github.com/EugeneErg"
    }
  ],
  "support": {
    "issues": "https://github.com/EugeneErg/OpenApi/issues",
    "source": "https://github.com/EugeneErg/OpenApi"
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "EugeneErg\\OpenApi\\": "src/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "test": "Run the PHPUnit test suite.",
    "stan": "Run PHPStan static analysis at max level.",
    "cs": "Report coding standard violations without changing files.",
    "cs:fix": "Apply coding standard fixes.",
    "check": "Run coding standards, static analysis and tests."
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "ext-yaml": "Для чтения YAML-спецификаций через Serialization\\YamlDecoder. На запись YAML не требуется."
  }
}
