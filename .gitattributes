# Line endings are normalised in the repository: the package writes documents with "\n",
# and a checkout on Windows must not turn the fixtures' expected JSON into CRLF.
* text=auto eol=lf

# What a consumer of the package does not need. `composer require --prefer-dist` unpacks
# the archive GitHub builds from these rules, so the corpus of real specifications and the
# development tooling stay out of vendor/.
/tests           export-ignore
/tools           export-ignore
/bin             export-ignore
/.github         export-ignore
/.editorconfig   export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.php-cs-fixer.php export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist  export-ignore
