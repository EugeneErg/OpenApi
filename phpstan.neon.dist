parameters:
    level: 10
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            # это тестовые данные, а не код: они намеренно собирают объекты
            # через промежуточные переменные и union-типы
            - tests/Cases/*
            - tests/Fixtures/*

    # Всё, что PHPStan умеет проверять сверх максимального уровня.
    checkBenevolentUnionTypes: true
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    # Выключено осознанно: опция помечает последнюю ветку исчерпывающего match
    # по enum как «всегда истинную». Но именно исчерпывающий match — то, что нужно:
    # заменив последнюю ветку на default, мы потеряли бы проверку полноты,
    # и новый вариант enum молча попал бы не туда.
    reportAlwaysTrueInLastCondition: false
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportAnyTypeWideningInVarTag: true
    reportWrongPhpDocTypeInVarTag: true
