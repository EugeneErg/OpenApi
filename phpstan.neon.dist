parameters:
    level: 10
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            # these are test data rather than code: they deliberately build objects
            # through intermediate variables and union types
            - tests/Cases/*
            - tests/Fixtures/*

    # Everything PHPStan can check beyond its maximum level.
    checkBenevolentUnionTypes: true
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    # Off deliberately: the option marks the last arm of an exhaustive match over an
    # enum as "always true". But an exhaustive match is exactly what is wanted here:
    # replacing the last arm with a default would lose the completeness check, and a new
    # case of the enum would quietly end up in the wrong place.
    reportAlwaysTrueInLastCondition: false
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportAnyTypeWideningInVarTag: true
    reportWrongPhpDocTypeInVarTag: true
